                            "ByteMatchStatement": {
                                "SearchString": "L2FwaS9jYXJ0L2NvdXBvbg==",
                                "FieldToMatch": {
                                    "UriPath": {}
                                },
                                "TextTransformations": [
                                    {
                                        "Priority": 0,
                                        "Type": "NONE"
                                    }
                                ],
                                "PositionalConstraint": "STARTS_WITH"
                            }
                        }
                    }
                },
                "Action": {
                    "Block": {}
                },
                "VisibilityConfig": {
                    "SampledRequestsEnabled": true,
                    "CloudWatchMetricsEnabled": true,
                    "MetricName": "rate-limit-coupon"
                }
            },
            {
                "Name": "count-new-bot-signals",
                "Priority": 3,
                "Statement": {
                    "ByteMatchStatement": {
                        "SearchString": "Ym90",
