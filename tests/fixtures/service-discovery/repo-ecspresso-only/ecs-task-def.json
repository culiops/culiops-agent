{
  "family": "paymentapi-task-{{ must_env `ENV` }}",
  "taskRoleArn": "{{ tfstate `aws_iam_role.paymentapi_task.arn` }}",
  "executionRoleArn": "{{ tfstate `aws_iam_role.paymentapi_exec.arn` }}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "{{ must_env `TASK_CPU` }}",
  "memory": "{{ must_env `TASK_MEMORY` }}",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "{{ tfstate `aws_ecr_repository.paymentapi.repository_url` }}:{{ must_env `IMAGE_TAG` }}",
      "essential": true,
      "portMappings": [{"containerPort": 8080, "protocol": "tcp"}],
      "secrets": [
        {"name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:paymentapi/{{ must_env `ENV` }}/db-password"},
        {"name": "STRIPE_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:paymentapi/{{ must_env `ENV` }}/stripe-api-key"}
      ],
      "environment": [
        {"name": "ENV", "value": "{{ must_env `ENV` }}"},
        {"name": "REGION", "value": "us-east-1"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/paymentapi-{{ must_env `ENV` }}",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
